# Copie este arquivo para ".env" e ajuste os valores conforme necessário.
# NUNCA versionar o arquivo ".env" real no Git (já está no .gitignore).

DB_NAME=use_autentica
DB_USER=use_autentica
DB_PASSWORD=troque_esta_senha

SPRING_PROFILES_ACTIVE=dev
APP_PORT=8080

# Gerar com: openssl rand -base64 32
JWT_SECRET=troque_este_segredo_por_uma_string_longa_e_aleatoria
JWT_EXPIRATION_MINUTES=1440

# Credenciais do usuário ADMIN criado automaticamente no primeiro start
ADMIN_EMAIL=admin@useautentica.com
ADMIN_PASSWORD=troque_esta_senha_tambem

# Pasta onde as imagens de produto sao salvas. Via docker compose fica em
# /app/uploads (volume ja configurado); rodando local sem Docker, pode
# deixar o padrao (./uploads, relativo ao diretorio de trabalho).
STORAGE_LOCAL_BASE_PATH=./uploads
